{
  "name": "dictum-cli",
  "version": "0.1.0",
  "description": "Voice-to-prompt CLI: dictate a thought, get a polished prompt in your clipboard",
  "type": "module",
  "bin": {
    "dictum": "bin/dictum.js"
  },
  "files": ["bin", "src", "README.md", "LICENSE"],
  "scripts": {
    "start": "bun run src/cli.ts",
    "build": "bun build --compile --minify --outfile dist/dictum src/cli.ts",
    "build:targets": "bash scripts/build-binaries.sh",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "keywords": ["voice", "stt", "prompt", "cli", "speech-to-text", "claude", "llm"],
  "license": "MIT",
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "smol-toml": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
